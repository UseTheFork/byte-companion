{
  "name": "byte-companion",
  "displayName": "byte-companion",
  "description": "",
  "version": "2026.6.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/UseTheFork/byte-companion/"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "byte-companion.folderAction",
        "title": "Add Folder to Byte"
      },
      {
        "command": "byte-companion.folderRemoveAction",
        "title": "Remove Folder from Byte"
      },
      {
        "command": "byte-companion.fileContextAction",
        "title": "Add File to Byte Context"
      },
      {
        "command": "byte-companion.fileContextDropAction",
        "title": "Drop File from Byte Context"
      },
      {
        "command": "byte-companion.reconnect",
        "title": "Reconnect to Byte"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "byte-companion.folderAction",
          "when": "explorerResourceIsFolder && byte-companion.connected",
          "group": "7_modification"
        },
        {
          "command": "byte-companion.folderRemoveAction",
          "when": "explorerResourceIsFolder && byte-companion.connected",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "byte-companion.fileContextAction",
          "when": "resourceScheme == file && byte-companion.connected",
          "group": "7_modification"
        },
        {
          "command": "byte-companion.fileContextDropAction",
          "when": "resourceScheme == file && byte-companion.connected",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.116.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ws": "^8.5.8",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
